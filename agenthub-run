#!/usr/bin/env bash
# 在 tmux 里启动 CLI 会话, 这样 agenthub 网页可以远程接管它。
# 用法:  ./agenthub-run              # 默认 claude
#        ./agenthub-run codex
#        ./agenthub-run claude --resume
# 使用 agenthub 专用 tmux server；状态栏、前缀键和 tmux 鼠标均关闭。
set -euo pipefail
CMD=${1:-claude}; shift || true
NAME="agenthub-${CMD##*/}-$(date +%H%M%S)"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
TMUX_CONF="$SCRIPT_DIR/agenthub/tmux.conf"
# -f 只在 server 首次启动时生效；已存在时显式刷新一次，配置文件本身可重复加载。
tmux -L agenthub -f "$TMUX_CONF" source-file "$TMUX_CONF" 2>/dev/null || true
exec tmux -L agenthub -f "$TMUX_CONF" new-session -A -s "$NAME" -c "$PWD" "$CMD" "$@"
