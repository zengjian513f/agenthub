__pycache__/
*.py[cod]

# Continuous-memory plugin runtime state is local, not application source.
.remember/

# Local editor and OS artifacts.
.DS_Store
*.swp
*~

# Composer uploads are runtime data, including the pre-rename legacy spelling.
.agenthub_attachments/
.agenthub_attachements/
agenthub_attachments/

# Real deployment details and credentials stay on the machine, never in Git.
/DEPLOYMENT.local.md
/CLAUDE.local.md
/.env
/.env.*
!/.env.example
/deploy/*.local.conf
# 随部署分发的会话宿主二进制，一次构建多机复用，不进 git
/bin/
