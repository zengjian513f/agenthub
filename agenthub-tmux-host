#!/usr/bin/env bash
# agenthub-tmux.service 的 ExecStart 包装。
#
# 已有 tmux server 托管 socket 时只守候其进程，不争抢 socket，也不结束其中的
# CLI 会话；server 退出后由 systemd 重启本脚本并以前台模式接管。
set -euo pipefail

SOCKET=agenthub
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
TMUX_CONF="$SCRIPT_DIR/agenthub/tmux.conf"
TMUX_BIN=${TMUX_BIN:-/usr/bin/tmux}
ZSH_ENV_WRAPPER=${ZSH_ENV_WRAPPER:-$HOME/.local/bin/with-zshrc}

if server_pid=$("$TMUX_BIN" -L "$SOCKET" display-message -p '#{pid}' 2>/dev/null); then
  echo "[agenthub-tmux] 已有 tmux server 持有 $SOCKET socket，守候 PID $server_pid"
  exec /usr/bin/tail --pid="$server_pid" -f /dev/null
fi

if [[ -x "$ZSH_ENV_WRAPPER" ]]; then
  exec "$ZSH_ENV_WRAPPER" "$TMUX_BIN" -D -L "$SOCKET" -f "$TMUX_CONF"
fi
exec "$TMUX_BIN" -D -L "$SOCKET" -f "$TMUX_CONF"
