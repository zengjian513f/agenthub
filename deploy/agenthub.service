[Unit]
Description=AgentHub session manager
Wants=network-online.target agenthub-tmux.service
After=network-online.target agenthub-tmux.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/agenthub
ExecStart=/usr/bin/python3 -u -m agenthub.server --host 0.0.0.0 --port 8710 --terminal
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
